     CARGO_BAZEL_DEBUG,
 ]
 
+def patch_cargo_bazel_nix(ctx, output):
+    """Patch prebuilt cargo-bazel binary for Nix sandbox execution."""
+    if "NIX_DYNAMIC_LINKER" not in ctx.os.environ:
+        return
+    ctx.execute(["chmod", "u+w", str(output)])
+    script = """
+import sys, os
+path = sys.argv[1]
+with open(path, "rb") as f:
+    data = f.read()
+orig = (
+    b"#!/usr/bin/env bash\\n#\\n# For details, see:\\n"
+    b"# `@rules_rust//crate_universe/src/metadata/cargo_tree_resolver.rs - TreeResolver::create_rustc_wrapper`"
+)
+if orig in data:
+    nix_bash = os.environ.get("NIX_BASH", "bash").encode()
+    prefix = b"#!/bin/sh\\n[ -z \\"$_IN_BASH\\" ] && _IN_BASH=1 exec " + nix_bash + b" \\"$0\\" \\"$@\\"\\n#"
+    pad = len(orig) - len(prefix)
+    assert pad >= 0, f"NIX_BASH path too long: {pad}"
+    repl = prefix + (b" " * pad)
+    assert len(repl) == len(orig)
+    data = data.replace(orig, repl)
+    with open(path, "wb") as f:
+        f.write(data)
+"""
+    ctx.execute([
+        ctx.os.environ.get("NIX_PYTHON3", "python3"),
+        "-c",
+        script,
+        str(output),
+    ])
+    ctx.execute([
+        ctx.os.environ.get("NIX_PATCHELF", "patchelf"),
+        "--set-interpreter",
+        ctx.os.environ["NIX_DYNAMIC_LINKER"],
+        "--force-rpath",
+        "--set-rpath",
+        ctx.os.environ.get("NIX_LIB_PATH", ""),
+        str(output),
+    ])
+
 def get_generator(repository_ctx, host_triple):
     """Query network resources to locate a `cargo-bazel` binary
 
