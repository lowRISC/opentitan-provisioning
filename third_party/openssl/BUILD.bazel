genrule(
    name = "openssl_bin",
    srcs = ["@openssl"],
    outs = ["openssl"],
    cmd = "for f in $(locations @openssl); do if [[ \"$$f\" == */bin/openssl ]]; then cp \"$$f\" $@; fi; done",
    executable = True,
    visibility = ["//visibility:public"],
)
